# API server env (copy to packages/api/.env). Used by `npm run dev -w api`
# and the provision CLI.

# Local Mongo (default — `podman compose up -d` from the repo root).
MONGO_URI=mongodb://admin:devpassword@localhost:27017/taskmanager?authSource=admin

# To run against an Atlas dev cluster instead, swap MONGO_URI for your SRV
# string. The database name MUST be in the path (before the "?") — Atlas's
# Connect dialog omits it by default:
#   mongodb+srv://user:pass@cluster.xxxxx.mongodb.net/taskmanager_dev?retryWrites=true&w=majority

# Optional. Defaults to 3000.
# PORT=3000
