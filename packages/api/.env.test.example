# Test env (copy to packages/api/.env.test). Used by `npm test -w api`.

# Local Mongo (default — fast, no network). Requires `podman compose up -d`.
MONGO_URI=mongodb://admin:devpassword@localhost:27017/taskmanager_test?authSource=admin

# Frictionless Atlas swap: to run the exact same suite against an Atlas dev
# cluster (no local Mongo needed), replace MONGO_URI with your SRV string.
# Keep a dedicated test database in the path so a run can't clobber dev data:
#   mongodb+srv://user:pass@cluster.xxxxx.mongodb.net/taskmanager_test?retryWrites=true&w=majority
