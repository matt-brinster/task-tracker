# Compose env (copy to .env at the repo root). Read by `docker compose up`.
# These configure the local mongodb container and port mapping only — the app
# service builds its own MONGO_URI from MONGO_USERNAME/PASSWORD/DATABASE.
MONGO_USERNAME=admin
MONGO_PASSWORD=devpassword
MONGO_DATABASE=taskmanager
MONGO_PORT=27017

# Optional. Host port for the app container. Defaults to 3000.
# PORT=3000
